  "blockB": {
    "_desc": "Riesgo medio. Ya excluido del catálogo universal por diseño — solo se aplica en máquinas con profile-local.json (autonomía total ya aceptada).",
    "dev_scan": {
      "scan_root": "C:\\Github\\",
      "detect": [
        "node_modules con módulos nativos (*.node)",
        "Electron en package.json",
        "pyproject.toml o setup.py con extensiones C",
        "*.csproj / proyectos .NET"
      ],
      "policy": "Si hay dependencia: conservar versión mínima necesaria y marcar el resto. Si no hay dependencia: proponer eliminar todo VS Community + Build Tools 2022/2026."
    },
    "candidates": {
      "visual_studio": [
