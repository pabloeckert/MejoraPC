{
  "_meta": {
    "profile": "Pablo — definitivo",
    "ram_gb": 8,
    "notes": "Perfil LOCAL de esta máquina — nunca viaja en el paquete USB (installer/build-package.ps1 lo excluye). Se mergea sobre data/universal-tweaks.json y data/universal-bloatware.json vía lib/helpers.ps1 (Get-MergedTweaksCatalog / Get-MergedBloatCatalog). En una PC ajena, este archivo lo genera modules/00-discover.ps1 (encuesta breve) en vez de estar curado a mano.",
    "updated": "2026-08-08",
    "origin": "manual"
  },
  "survey": {},
  "registry": {
    "vs_telemetria": [
      { "path": "HKLM:\\SOFTWARE\\Microsoft\\VSCommon\\17.0\\SQM", "name": "OptIn", "value": 0, "type": "DWord" },
      { "path": "HKLM:\\SOFTWARE\\Microsoft\\VSCommon\\18.0\\SQM", "name": "OptIn", "value": 0, "type": "DWord" }
    ]
  },
  "startup_disable": {
    "corel_update_helper": {
      "_desc": "Deshabilitar CorelUpdateHelper en HKCU Run + Task Scheduler. No desinstala, no afecta licencia.",
      "run_keys": [
        "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run"
      ],
      "match": "CorelUpdateHelper",
      "ram_estimate_mb": 200
    },
    "roblox_autostart": {
      "_desc": "Roblox no necesita precargarse al boot — el hijo lo abre cuando quiere jugar. No desinstala nada.",
      "run_keys": [
        "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run"
      ],
      "match": "^RobloxPlayerBeta$",
      "ram_estimate_mb": 60
    },
    "chrome_autolaunch": {
      "_desc": "Chrome se auto-lanza al login (GoogleChromeAutoLaunch_<hash>, sufijo cambia por instalación). Chrome sigue disponible normalmente, solo no arranca solo.",
      "run_keys": [
        "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run"
      ],
      "match": "^GoogleChromeAutoLaunch",
      "ram_estimate_mb": 150
    },
    "canva_autolaunch": {
      "_desc": "Agente de background de Canva Desktop (availability check). No desinstala Canva, solo el auto-arranque.",
      "run_keys": [
        "HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run",
        "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run"
      ],
      "match": "CanvaAutoLaunch",
      "ram_estimate_mb": 40
    }
  },
  "ram_recoverable_estimate": {
    "corel_helper_off": 200,
    "roblox_autostart_off": 60,
    "chrome_autolaunch_off": 150,
    "canva_autolaunch_off": 40
  },
  "blockA_extra": {
