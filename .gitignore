# Logs
logs/

# Datos de runtime / usuario (la DB es la fuente de verdad local)
data/mejorapc.db
data/status.json
data/monitor.log
data/last-verify.json
data/discovery-report.json
data/last-hardware-check.json
data/last-startup-audit.json

# Backups generados (contienen info del sistema del usuario)
backups/
reporte_limpieza_resultado.*

# Paquete USB generado por installer/build-package.ps1
dist/

# Rescue points (contienen info del sistema del usuario)
rescue/

# Destino de espejo de diagnóstico para un despliegue puntual (ver
# run.ps1) — contiene una ruta con nombre de usuario/carpeta de otra
# persona, no del propio Pablo. Se arma a mano antes de empaquetar para
# ese despliegue específico, no es parte del template universal.
data/mirror-output-dir.txt

# Profiles (configuraciones del usuario)
profiles/

# State files
*_state.json

# PowerShell temp
*.ps1xml

# Python
__pycache__/
*.pyc

# Windows
Thumbs.db
Desktop.ini

# Claude Code local state (settings/permissions/locks de esta máquina —
# no las skills, que sí viajan con el repo: son código/config, igual que
# data/profile-local.json)
.claude/settings.local.json
.claude/scheduled_tasks.lock
